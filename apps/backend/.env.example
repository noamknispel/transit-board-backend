# GTFS Feed URL (default: MTA NYC Subway)
GTFS_FEED_URL=https://rrgtfsfeeds.s3.amazonaws.com/gtfs_subway.zip

# --- Rendered display (all optional; defaults shown) ---
# Size of the LED matrix the backend renders for (two chained 64x32 panels)
DISPLAY_WIDTH=128
DISPLAY_HEIGHT=32
# How often the board is told to poll /devices/:id/display
DISPLAY_POLL_SECONDS=10
# Max frames per device; each one takes ~4 KB of the microcontroller's RAM
DISPLAY_MAX_FRAMES=16

# --- Microcontroller serial console (Linux only; shown in the dashboard) ---
# Defaults to the first /dev/serial/by-id device, then /dev/ttyACM0. "off" disables it.
# SERIAL_PORT=/dev/ttyACM0
# SERIAL_LOG_LINES=500
