# GTFS Feed URL (default: MTA NYC Subway)
GTFS_FEED_URL=https://rrgtfsfeeds.s3.amazonaws.com/gtfs_subway.zip

# --- Rendered display (all optional; defaults shown) ---
# Size of the LED matrix the backend renders for (two chained 64x32 panels)
DISPLAY_WIDTH=128
DISPLAY_HEIGHT=32
# How often the board is told to poll /devices/:id/display
DISPLAY_POLL_SECONDS=10
# Per-channel gain "red,green,blue" for a panel whose white looks tinted, e.g. 1,0.85,0.6 for a blue-heavy one
# DISPLAY_COLOR_BALANCE=1,1,1
# Must match BIT_DEPTH in the firmware (apps/microcontroller/code.py): 4, 5 or 6. Default 5
# DISPLAY_BIT_DEPTH=5
# Max frames per device; each one takes ~4 KB of the microcontroller's RAM
DISPLAY_MAX_FRAMES=16

# --- Microcontroller serial console (Linux only; shown in the dashboard) ---
# Defaults to the first /dev/serial/by-id device, then /dev/ttyACM0. "off" disables it.
# SERIAL_PORT=/dev/ttyACM0
# SERIAL_LOG_LINES=500

# --- Spotify "Now Playing" widget ---
# Create an app at https://developer.spotify.com/dashboard, register the redirect URI below
# on it, then run `bun run spotify:connect` once to link your account.
# SPOTIFY_CLIENT_ID=
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
# SPOTIFY_CACHE_TTL_SECONDS=5
# Album art darkening for the LED panel: higher is darker, 1 is off (default 0.9: below 1 lifts dark tones a little, 1 is off)
# SPOTIFY_ART_GAMMA=0.9
# Extra color saturation so faint hues survive the panel's 16 levels: 1 is off (default 1.15)
# SPOTIFY_ART_SATURATION=1.15
# Brighten dark covers by up to this much so they use more of the panel's levels; 0 is off (default 2.5)
# SPOTIFY_ART_AUTOLEVEL=2.5
# Pixel-style art is this many blocks across the 32px square: 8 (chunky) or 16 (finer), default 8
# SPOTIFY_ART_BLOCKS=8
